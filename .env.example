# Optional future integrations
VITE_MAP_PROVIDER_TOKEN=
VITE_BACKEND_URL=

# Server-only: connect a dedicated preview Neon Postgres database.
DATABASE_URL=
# Server-only: shared invitation for the CLOSED two-phone pilot; minimum 16 characters.
# Participants can choose either test role. This is not production driver approval.
RIVO_PILOT_CODE=

# Server-only: Managed Neon Auth on the dedicated Preview database branch.
NEON_AUTH_BASE_URL=
# Generate a random secret of at least 32 characters. Never prefix with VITE_.
RIVO_AUTH_RATE_SECRET=
# Comma-separated verified emails allowed to review driver applications.
# Empty grants nobody access; accounts cannot approve their own application.
RIVO_REVIEWER_EMAILS=

# Server-only Web Push. Generate a separate key pair per environment.
RIVO_VAPID_PUBLIC_KEY=
RIVO_VAPID_PRIVATE_KEY=
# Public HTTPS site origin, also used as the VAPID contact URI.
RIVO_PUSH_ORIGIN=
# Bearer secret for the daily scheduled endpoint. Cron runs only in production.
CRON_SECRET=
